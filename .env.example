# Database
MONGODB_URI=

# JWT
JWT_SECRET=
JWT_EXPIRE=

# Server
PORT=
NODE_ENV=
# Email (Optional)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=

# File Upload
MAX_FILE_SIZE=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=

# Frontend
CLIENT_URL=

# Multi-tenancy
# The platform's own domain, without protocol/port. Every tenant's site is
# served at <subdomain>.PLATFORM_DOMAIN. In development this can stay
# "localhost" — see server/middlewares/tenantMiddleware.js for the local
# dev fallback (X-Tenant-Subdomain header / ?tenant= query param).
PLATFORM_DOMAIN=
